<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="CynthiaMiniISAPI" path="*" verb="*" modules="IsapiModule"
           scriptProcessor="C:\inetpub\CynthiaMini\CynthiaMini.dll"
           resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
    <httpErrors errorMode="DetailedLocalOnly" />
  </system.webServer>
</configuration>
